root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,css,scss,sass,less,styl}]
charset = utf-8
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
max_line_length = 100

[*.{md}]
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

end_of_line = lf
max_line_length = 100

[*.{sh}]
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,bat}]
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = crlf
