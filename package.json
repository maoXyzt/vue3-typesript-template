{
  "name": "anna-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "prepare": "husky",
    "release:major": "changelog -M && git add CHANGELOG.md && git commit -m \"updated CHANGELOG.md\" && npm version major && git push origin && git push origin --tags",
    "release:minor": "changelog -m && git add CHANGELOG.md && git commit -m \"updated CHANGELOG.md\" && npm version minor && git push origin && git push origin --tags",
    "release:patch": "changelog -p && git add CHANGELOG.md && git commit -m \"updated CHANGELOG.md\" && npm version patch && git push origin && git push origin --tags",
    "client:update-spec": "cross-env OUTPUT_FILE=codegen/openapi.json node codegen/run-update.js",
    "client:generate": "uvx \"openapi-generator-cli[jdk4py]==7.14.0\" generate -c openapitools.yml"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.90.5",
    "@vueuse/core": "^13.9.0",
    "@vueuse/router": "^13.9.0",
    "axios": "^1.12.2",
    "bulma": "^1.0.4",
    "highlight.js": "^11.11.1",
    "moment": "^2.30.1",
    "pinia": "^3.0.3",
    "tiny-invariant": "^1.3.3",
    "unplugin-icons": "^22.5.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@iconify-json/material-symbols": "^1.2.21",
    "@iconify-json/tabler": "^1.2.18",
    "@iconify/json": "^2.2.340",
    "@iconify/vue": "^5.0.0",
    "@prettier/plugin-oxc": "^0.0.4",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tanstack/vue-query-devtools": "^5.87.3",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.6",
    "@unocss/eslint-config": "^66.5.4",
    "@unocss/preset-icons": "^66.5.4",
    "@unocss/preset-rem-to-px": "^66.5.4",
    "@unocss/preset-wind3": "^66.5.4",
    "@unocss/reset": "^66.5.4",
    "@unocss/transformer-directives": "^66.5.4",
    "@unocss/transformer-variant-group": "^66.5.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.33.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-oxlint": "~1.11.0",
    "eslint-plugin-vue": "~10.4.0",
    "generate-changelog": "^1.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "lint-staged": "^16.2.4",
    "naive-ui": "^2.43.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.11.0",
    "postcss": "^8.5.6",
    "postcss-nesting": "^13.0.2",
    "prettier": "3.6.2",
    "sass-embedded": "^1.93.2",
    "typescript": "~5.9.0",
    "unocss": "^66.5.4",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vfonts": "^0.0.3",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vue-tsc": "^3.1.0"
  },
  "optionalDependencies": {
    "@types/node": "^22.15.21",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/webfontloader": "^1.6.38"
  },
  "packageManager": "pnpm@10.18.1"
}
